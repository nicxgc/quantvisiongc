# ============================================================
# QuantVisionGC - Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y rellena con valores reales.
# Comando: cp .env.example .env  (Linux/Mac)
#         copy .env.example .env  (Windows)
# ============================================================

# === Base de datos PostgreSQL+TimescaleDB ===
POSTGRES_USER=tu_usuario_bbdd
POSTGRES_PASSWORD=tu_contraseña_bbdd
POSTGRES_DB=tu_nombre_bbdd

DATABASE_URL=postgresql+psycopg2://tu_usuario_bbdd:tu_contraseña_bbdd@localhost:5433/tu_nombre_bbdd

# === Seguridad / JWT ===
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=reemplazar_por_secreto_aleatorio_de_64_caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Configuración del backend ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development